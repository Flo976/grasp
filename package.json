{
  "name": "grasp",
  "version": "0.5.0",
  "description": "Serveur de contrôle de navigateur pour agents IA, piloté par l'arbre d'accessibilité (CDP direct)",
  "type": "module",
  "bin": {
    "grasp": "dist/src/cli/main.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p .",
    "test": "tsc -p . && node --test --test-concurrency=1 'dist/test/**/*.test.js'",
    "test:unit": "tsc -p . && node --test 'dist/test/unit/*.test.js'",
    "changelog": "node scripts/check-changelog.mjs",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true"
  },
  "license": "MIT",
  "dependencies": {
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "playwright-core": ">=1.64.0"
  },
  "peerDependenciesMeta": {
    "playwright-core": {
      "optional": true
    }
  }
}
